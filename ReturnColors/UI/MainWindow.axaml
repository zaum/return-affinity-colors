<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:ReturnColors.UI"
        xmlns:r="using:ReturnColors"
        mc:Ignorable="d"
        x:Class="ReturnColors.UI.MainWindow"
        Title="Return Affinity Colors"
        Width="780" Height="600"
        MinWidth="600" MinHeight="480"
        FontSize="14">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="Return Affinity Colors" FontSize="24" FontWeight="Bold" />

            <Border BorderBrush="#44555555" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                    <TextBlock Text="Status:" Grid.Row="0" Grid.Column="0" />
                    <SelectableTextBlock x:Name="StatusText" Text="Searching for Affinity..." FontWeight="Bold" Grid.Row="0" Grid.Column="1" />

                    <TextBlock Text="Path:" Grid.Row="1" Grid.Column="0" />
                    <SelectableTextBlock x:Name="PathText" Text="-" FontWeight="Bold" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" />

                    <TextBlock Text="Admin rights:" Grid.Row="2" Grid.Column="0" />
                    <SelectableTextBlock x:Name="AdminText" Text="-" FontWeight="Bold" TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" />

                    <TextBlock Text="Write access:" Grid.Row="3" Grid.Column="0" />
                    <SelectableTextBlock x:Name="WriteText" Text="-" FontWeight="Bold" Grid.Row="3" Grid.Column="1" />

                    <TextBlock Text="Detected files:" Grid.Row="4" Grid.Column="0" />
                    <SelectableTextBlock x:Name="DetectedText" Text="-" FontWeight="Bold" TextWrapping="Wrap" Grid.Row="4" Grid.Column="1" />
                </Grid>
            </Border>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="0">
                <Button x:Name="RunButton" Content="Colorize icons" FontWeight="Bold" FontSize="15" Padding="16,6" Background="DodgerBlue" Foreground="White" />
                <Button x:Name="SplashButton" Content="Replace splash" FontWeight="Bold" FontSize="15" Padding="16,6" Background="DodgerBlue" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RestoreButton" Content="Restore backup" />
                <Button x:Name="BrowseButton" Content="Select Affinity folder..." />
                <Button x:Name="ImportButton" Content="Import icons" />
                <Button x:Name="DumpButton" Content="Dump icons" />
            </StackPanel>
        </Grid>

        <Border Background="Black" BorderBrush="#44555555" BorderThickness="1" CornerRadius="4" Padding="8">
            <ListBox x:Name="LogList" Background="Black" BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Black" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Black" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Black" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type r:LogEntry}">
                        <StackPanel Orientation="Horizontal" Spacing="3" Margin="2,0">
                            <TextBlock Text="{Binding Level, Converter={x:Static ui:LogLevelToIconConverter.Instance}}" Foreground="#FFFF0000" FontSize="14" VerticalAlignment="Center" FontFamily="Segoe UI, Arial" />
                            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="White" LineHeight="22" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
